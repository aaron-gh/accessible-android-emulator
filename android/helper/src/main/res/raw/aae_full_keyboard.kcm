# AAE full keyboard: makes the emulator's keyboard behave like a PC keyboard.
#
# The emulator's keyboard uses qwerty2.kl, a phone layout: Escape is Back,
# Home is the Home button, End ends calls, most function keys are phone keys,
# and Meta, Page Up, Page Down, Insert, backtick and the keypad are missing.
# This overlay maps those scan codes the way Android's Generic.kl does, so
# every key AAE sends arrives as the key the user pressed. Meta matters most:
# TalkBack's keyboard shortcuts use it as their modifier.
#
# Android's own Home button moves to scan code 172 (KEY_HOMEPAGE), so the
# keyboard's Home key can mean "start of line".

type OVERLAY

map key 1 ESCAPE
map key 41 GRAVE
map key 59 F1
map key 60 F2
map key 61 F3
map key 62 F4
map key 63 F5
map key 64 F6
map key 65 F7
map key 66 F8
map key 67 F9
map key 68 F10
map key 87 F11
map key 88 F12
map key 102 MOVE_HOME
map key 107 MOVE_END
map key 104 PAGE_UP
map key 109 PAGE_DOWN
map key 110 INSERT
map key 113 VOLUME_MUTE
map key 125 META_LEFT
map key 126 META_RIGHT
map key 127 MENU
map key 172 HOME
map key 86 BACKSLASH
map key 69 NUM_LOCK
map key 70 SCROLL_LOCK
map key 55 NUMPAD_MULTIPLY
map key 71 NUMPAD_7
map key 72 NUMPAD_8
map key 73 NUMPAD_9
map key 74 NUMPAD_SUBTRACT
map key 75 NUMPAD_4
map key 76 NUMPAD_5
map key 77 NUMPAD_6
map key 78 NUMPAD_ADD
map key 79 NUMPAD_1
map key 80 NUMPAD_2
map key 81 NUMPAD_3
map key 82 NUMPAD_0
map key 83 NUMPAD_DOT
map key 96 NUMPAD_ENTER
map key 98 NUMPAD_DIVIDE
map key 117 NUMPAD_EQUALS

key GRAVE {
    label:                              '`'
    base:                               '`'
    shift:                              '~'
}

key NUMPAD_0 {
    label:                              '0'
    base:                               '0'
}

key NUMPAD_1 {
    label:                              '1'
    base:                               '1'
}

key NUMPAD_2 {
    label:                              '2'
    base:                               '2'
}

key NUMPAD_3 {
    label:                              '3'
    base:                               '3'
}

key NUMPAD_4 {
    label:                              '4'
    base:                               '4'
}

key NUMPAD_5 {
    label:                              '5'
    base:                               '5'
}

key NUMPAD_6 {
    label:                              '6'
    base:                               '6'
}

key NUMPAD_7 {
    label:                              '7'
    base:                               '7'
}

key NUMPAD_8 {
    label:                              '8'
    base:                               '8'
}

key NUMPAD_9 {
    label:                              '9'
    base:                               '9'
}

key NUMPAD_DIVIDE {
    label:                              '/'
    base:                               '/'
}

key NUMPAD_MULTIPLY {
    label:                              '*'
    base:                               '*'
}

key NUMPAD_SUBTRACT {
    label:                              '-'
    base:                               '-'
}

key NUMPAD_ADD {
    label:                              '+'
    base:                               '+'
}

key NUMPAD_DOT {
    label:                              '.'
    base:                               '.'
}

key NUMPAD_EQUALS {
    label:                              '='
    base:                               '='
}

key NUMPAD_ENTER {
    label:                              '\n'
    base:                               '\n'
}
