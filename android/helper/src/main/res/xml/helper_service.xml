<?xml version="1.0" encoding="utf-8"?>
<!-- What AAE's helper does as an accessibility service:
     - Sets the accessibility volume, which Android allows only for services
       that declare flagEnableAccessibilityVolume.
     - Filters keys, for AAE's keyboard test: it looks at them only while the
       test runs, and otherwise passes every key straight on. (Turning
       filtering on only for the test, at run time, didn't work on Android 11.)
     - Reads the screen's accessibility tree, for AAE's accessibility inspector,
       only when AAE asks.
     - Counts changes to the screen, so the inspector can follow it: it keeps
       only how many there have been and when the last was, nothing about
       what changed. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeAnnouncement|typeWindowStateChanged|typeWindowsChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagEnableAccessibilityVolume|flagRequestFilterKeyEvents|flagRetrieveInteractiveWindows|flagReportViewIds"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="true"
    android:description="@string/service_description"
    android:isAccessibilityTool="true"
    android:notificationTimeout="0" />
