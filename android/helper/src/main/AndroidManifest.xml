<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:label="@string/app_name">

        <service
            android:name=".HelperService"
            android:exported="true"
            android:label="@string/service_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/helper_service" />
        </service>

        <!-- Commands from AAE, sent with adb shell am broadcast. Requiring DUMP
             means only the shell and the system can send them, not other apps. -->
        <receiver
            android:name=".CommandReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="io.github.aaron_gh.aae.helper.SET_VOLUME" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
