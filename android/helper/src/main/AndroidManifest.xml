<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- To list every installed app, with its name, for AAE's Apps window.
         The helper is installed only by AAE, never from an app store. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Checking sound reaches the microphone, when AAE asks. Nothing is kept. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Android 11 and later hide other apps' services unless an app says what
         it looks for. The speech check needs to find speech engines. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:label="@string/app_name">

        <service
            android:name=".HelperService"
            android:exported="true"
            android:label="@string/service_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/helper_service" />
        </service>

        <!-- AAE's speech relay: while AAE's speech log or speech bridge is on,
             this is the device's speech engine. It passes each request to the
             real one, recording it for the speech log, or sends it to the
             computer's voice. -->
        <service
            android:name=".RelayTtsService"
            android:exported="true"
            android:label="@string/relay_name">
            <intent-filter>
                <action android:name="android.intent.action.TTS_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.speech.tts"
                android:resource="@xml/relay_tts" />
        </service>

        <!-- Commands from AAE, sent with adb shell am broadcast. Requiring DUMP
             means only the shell and the system can send them, not other apps. -->
        <receiver
            android:name=".CommandReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="io.github.aaron_gh.aae.helper.SET_VOLUME" />
                <action android:name="io.github.aaron_gh.aae.helper.KEY_TEST" />
                <action android:name="io.github.aaron_gh.aae.helper.CHECK_SPEECH" />
                <action android:name="io.github.aaron_gh.aae.helper.PLAY_TONE" />
                <action android:name="io.github.aaron_gh.aae.helper.DUMP_TREE" />
                <action android:name="io.github.aaron_gh.aae.helper.SPEECH_RELAY" />
                <action android:name="io.github.aaron_gh.aae.helper.SPEECH_LOG" />
            </intent-filter>
        </receiver>
        <!-- Offers the AAE full keyboard layout to Android. -->
        <receiver
            android:name=".KeyboardLayouts"
            android:exported="true">
            <intent-filter>
                <action android:name="android.hardware.input.action.QUERY_KEYBOARD_LAYOUTS" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.input.metadata.KEYBOARD_LAYOUTS"
                android:resource="@xml/keyboard_layouts" />
        </receiver>
    </application>
</manifest>
