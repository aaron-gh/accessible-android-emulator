<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Finding computers on the local network. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <!-- The device's vibrations. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The phone's microphone, sent to a device when you turn it on. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Keeping the device's sound and the connection going with the screen off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Installing its own updates. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- The phone's speech engines, so the speech bridge speaks with the one
         chosen in the phone's settings: since Android 11, an app sees only
         the engines it asks for, and otherwise gets Google's. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".RemoteApp"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
        android:supportsRtl="true">
        <!-- Two screens side by side on wide windows (res/xml/split_rules.xml). -->
        <property
            android:name="android.window.PROPERTY_ACTIVITY_EMBEDDING_SPLITS_ENABLED"
            android:value="true" />

        <activity
            android:name=".ComputersActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".DevicesActivity" />
        <activity android:name=".DeviceActivity" />
        <activity android:name=".NewDeviceActivity" />
        <activity android:name=".VersionsActivity" />
        <activity android:name=".SetupActivity" />
        <activity android:name=".ToolsActivity" />
        <activity android:name=".DeviceSettingsActivity" />
        <activity android:name=".BridgeTtsActivity" />
        <activity android:name=".SpeechLogActivity" />
        <activity android:name=".LogActivity" />
        <activity android:name=".InspectorActivity" />
        <activity android:name=".AppsActivity" />
        <activity android:name=".ServicesActivity" />
        <activity android:name=".SnapshotsActivity" />
        <activity android:name=".ConditionsActivity" />
        <activity android:name=".LinkActivity" />
        <activity
            android:name=".KeyboardActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout" />
        <activity
            android:name=".GestureActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" />

        <receiver
            android:name=".UpdateReceiver"
            android:exported="false" />

        <service
            android:name=".AttachedService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false" />

        <!-- Lets touches through to the device while gesture mode is open. -->
        <service
            android:name=".GestureModeService"
            android:label="@string/gesture_mode_service"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/gesture_mode_service" />
        </service>
    </application>
</manifest>
